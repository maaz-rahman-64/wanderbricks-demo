{
  "datasets": [
    {
      "name": "destination_summary",
      "displayName": "Destination Summary",
      "queryLines": [
        "SELECT",
        "  SUM(gross_booking_value) AS gross_booking_value,",
        "  SUM(paid_amount) AS paid_amount,",
        "  SUM(booking_count) AS booking_count,",
        "  SUM(completed_booking_count) AS completed_booking_count ",
        "FROM gold_destination_revenue"
      ]
    },
    {
      "name": "top_destinations",
      "displayName": "Top Destinations",
      "queryLines": [
        "SELECT",
        "  destination,",
        "  gross_booking_value,",
        "  booking_count,",
        "  average_booking_value ",
        "FROM gold_destination_revenue ",
        "ORDER BY gross_booking_value DESC ",
        "LIMIT 10 "
      ]
    },
    {
      "name": "property_recovery",
      "displayName": "Property Recovery Watchlist",
      "queryLines": [
        "SELECT",
        "  property_title,",
        "  destination,",
        "  property_type,",
        "  gross_booking_value,",
        "  review_count,",
        "  average_rating,",
        "  low_rating_count,",
        "  guest_recovery_signal ",
        "FROM gold_property_quality ",
        "WHERE guest_recovery_signal IN ('review', 'watch') ",
        "ORDER BY gross_booking_value DESC, average_rating ASC ",
        "LIMIT 20"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "layout": [
