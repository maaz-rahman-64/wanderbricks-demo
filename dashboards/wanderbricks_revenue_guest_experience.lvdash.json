                  "fields": [
                    {
                      "name": "gross_booking_value",
                      "expression": "`gross_booking_value`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "gross_booking_value",
                  "displayName": "Gross Booking Value",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact"
                  }
                }
              },
              "frame": {
